{
  "schema_version": "0.1.0",
  "dimensions": [
    {
      "id": "technical_innovation",
      "label": "技术创新",
      "weight_percent": 30,
      "items": [
        {
          "claim": "开放 .bugcapsule Schema、内容派生 Evidence ID、确定性归档和逐文件 SHA-256 完整性校验",
          "paths": [
            "docs/capsule-schema.md",
            "src/bugcapsule/capsule/schema.py",
            "src/bugcapsule/capsule/archive.py",
            "tests/capsule/test_archive.py",
            "examples/connection-leak-simulated.bugcapsule"
          ],
          "verification": "uv run pytest tests/capsule/test_archive.py tests/test_examples.py -o addopts=",
          "status": "verified"
        },
        {
          "claim": "模型根因和 Patch 必须引用本次请求中的 Evidence ID，未知引用、越界路径和保护文件修改由本地拒绝",
          "paths": [
            "src/bugcapsule/analysis/service.py",
            "src/bugcapsule/patching/safety.py",
            "tests/analysis/test_service.py",
            "tests/patching/test_safety.py"
          ],
          "verification": "uv run pytest tests/analysis tests/patching -o addopts=",
          "status": "verified"
        },
        {
          "claim": "Patch ID、完整 SHA-256 与明确批准三重绑定，补丁仅进入受限 before/after 临时副本",
          "paths": [
            "src/bugcapsule/verification/service.py",
            "src/bugcapsule/verification/docker.py",
            "Dockerfile.verify",
            "tests/verification/test_service.py"
          ],
          "verification": "uv run pytest tests/verification -o addopts=",
          "status": "verified"
        }
      ]
    },
    {
      "id": "scenario_delivery",
      "label": "场景落地",
      "weight_percent": 30,
      "items": [
        {
          "claim": "FastAPI 与 PostgreSQL 主场景以固定两连接池稳定制造连接泄漏、耗尽和重置状态序列",
          "paths": [
            "compose.yml",
            "src/bugcapsule/demo/app.py",
            "src/bugcapsule/demo/database.py",
            "src/bugcapsule/demo/controller.py",
            "tests/demo/test_database.py",
            "tests/demo/test_controller.py",
            ".github/workflows/ci.yml"
          ],
          "verification": "docker compose up --build --detach --wait；随后 uv run bugcapsule demo run 和 uv run bugcapsule demo capture",
          "status": "partially_verified"
        },
        {
          "claim": "Trace、日志、源码、Git 与环境形成因果时间线，并由 CLI、Web 和自包含 HTML 报告读取同一事实源",
          "paths": [
            "src/bugcapsule/capsule/capture.py",
            "src/bugcapsule/capsule/evidence.py",
            "src/bugcapsule/index.py",
            "src/bugcapsule/reporting/service.py",
            "tests/test_web.py"
          ],
          "verification": "uv run pytest tests/capsule/test_capture.py tests/capsule/test_evidence.py tests/test_web.py tests/reporting -o addopts=",
          "status": "verified"
        },
        {
          "claim": "12 个版本化仿真案例平均覆盖三类故障，评测 Top-1、引用有效率、证据覆盖率和分段 P50/P95",
          "paths": [
            "docs/benchmark.md",
            "src/bugcapsule/benchmarking/dataset.json",
            "src/bugcapsule/benchmarking/evaluation.py",
            "tests/benchmarking/test_evaluation.py"
          ],
          "verification": "uv run bugcapsule benchmark build --output benchmark-data；uv run bugcapsule benchmark run --mode replay --output benchmark-replay",
          "status": "verified"
        },
        {
          "claim": "受限 Docker 固定回归在修复前和修复后各重复 20 次",
          "paths": [
            ".github/workflows/ci.yml",
            "verification_tests/test_connection_release.py",
            "verification_tests/fixtures/connection-release.diff"
          ],
          "verification": "CI / demo-integration 的 Verify restricted regression is stable for 20 before/after runs 步骤",
          "status": "external_pending"
        }
      ]
    },
