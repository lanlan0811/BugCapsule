# BugCapsule repository ignore rules

# Python bytecode and native build caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Python package and release build outputs
/build/
/dist/
/.eggs/
*.egg-info/
*.egg
/wheels/
/sdist/
MANIFEST

# Virtual environments and local interpreters
/.venv/
/venv/
/env/
/ENV/
.Python
__pypackages__/

# Local environment configuration and secrets
.env
.env.*
!.env.example

# Tests, coverage, linting, and type-checking caches
/.pytest_cache/
/.ruff_cache/
/.mypy_cache/
/.hypothesis/
/.tox/
/.nox/
/.pyre/
/.pytype/
/.coverage
/.coverage.*
/coverage.xml
/htmlcov/
*.cover
*.py,cover

# BugCapsule local runtime state
/.bugcapsule-data/

# First-user usability session worksheets (raw participant records stay local)
/usability-sessions/

# Generated benchmark and release evidence
/benchmark-data/
/benchmark-replay/
/benchmark-live/
/supply-chain/

# Temporary local outputs
/tmp/
/downloads/
*.log

# Documentation build outputs
/docs/_build/
/site/

# Editors and operating systems
/.idea/
/.vscode/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Local planning and design workspaces (retained project rules)
docs/Development-Draft/

.codex/*
.zcode/*
.trae/*

AGENTS.md

.design_library/
