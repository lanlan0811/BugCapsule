# BugCapsule local Web service
BUGCAPSULE_HOST=127.0.0.1
BUGCAPSULE_PORT=8765
BUGCAPSULE_LOG_LEVEL=INFO
BUGCAPSULE_MODEL_MODE=off
BUGCAPSULE_MODEL_API_STYLE=responses
BUGCAPSULE_MODEL_BASE_URL=https://api.openai.com/v1
BUGCAPSULE_MODEL_API_KEY=
BUGCAPSULE_MODEL_NAME=
BUGCAPSULE_MODEL_PROVIDER=openai-compatible
BUGCAPSULE_MODEL_TIMEOUT_SECONDS=60
BUGCAPSULE_MODEL_MAX_OUTPUT_TOKENS=2000
BUGCAPSULE_MODEL_MAX_INPUT_BYTES=65536
BUGCAPSULE_REPLAY_DIR=.bugcapsule-data/replay
BUGCAPSULE_PATCH_MAX_BYTES=262144
BUGCAPSULE_PATCH_ALLOWED_ROOTS=["src"]
BUGCAPSULE_PATCH_PROTECTED_PATHS=[".env",".env.example",".github",".gitee","Dockerfile","compose.yml","pyproject.toml","requirements.txt","tests","uv.lock"]
BUGCAPSULE_DISPLAY_TIMEZONE=Asia/Shanghai
BUGCAPSULE_MAX_IMPORT_BYTES=20971520
BUGCAPSULE_DATA_DIR=.bugcapsule-data
BUGCAPSULE_DEMO_TELEMETRY_DIR=.bugcapsule-data/demo
BUGCAPSULE_SOURCE_ROOT=.
BUGCAPSULE_SOURCE_INCLUDE_ROOT=src
BUGCAPSULE_SOURCE_CONTEXT_LINES=30

# Demo order service and PostgreSQL (simulation data only)
POSTGRES_USER=bugcapsule
POSTGRES_PASSWORD=replace-with-a-local-demo-password
POSTGRES_DB=bugcapsule_demo
BUGCAPSULE_DEMO_DATABASE_URL=postgresql+psycopg://bugcapsule:replace-with-a-local-demo-password@127.0.0.1:55432/bugcapsule_demo
BUGCAPSULE_DEMO_HOST=127.0.0.1
BUGCAPSULE_DEMO_PORT=8766
BUGCAPSULE_DEMO_DB_PORT=55432
BUGCAPSULE_DEMO_POOL_SIZE=2
BUGCAPSULE_DEMO_MAX_OVERFLOW=0
BUGCAPSULE_DEMO_POOL_TIMEOUT_SECONDS=1.0
BUGCAPSULE_DEMO_API_URL=http://127.0.0.1:8766
BUGCAPSULE_DEMO_COMPOSE_FILE=compose.yml
BUGCAPSULE_DEMO_COMMAND_TIMEOUT_SECONDS=180
BUGCAPSULE_DEMO_TELEMETRY_ENABLED=true
BUGCAPSULE_DEMO_SERVICE_NAME=demo-order-api
